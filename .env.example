# DISC × AI 镜像实验室 - 环境变量模板
# 复制此文件为 .env 并填入真实值

# OpenAI API Key (必填) - 用于 LLM (qwen-plus)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 模型配置 (可选，有默认值)
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=800

# 调试开关 (可选)
DEBUG_PROMPT=false
DEBUG_RESPONSE=false

# ===== W5 语音交互集成 =====
# DashScope API Key - 用于 Paraformer ASR + CosyVoice TTS
# 实际与 LLM_API_KEY 同一个通义千问 key（sk- 开头），代码层分变量便于后续换厂商
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 百炼业务空间 ID（必填，语音服务用）
# CosyVoice/Paraformer 的 maas 域名形如 wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/...
# 获取：https://help.aliyun.com/zh/model-studio/obtain-the-app-id-and-workspace-id
DASHSCOPE_WORKSPACE_ID=

# 语音服务端口 (可选，默认 4173)
VOICE_PORT=4173

# CosyVoice 模型 (可选，默认 cosyvoice-v3-flash)
COSYVOICE_MODEL=cosyvoice-v3-flash

# Paraformer 模型 (可选，默认 paraformer-realtime-v2)
PARAFORMER_MODEL=paraformer-realtime-v2

# 绕过公司网络自签名证书 (PoC 阶段)
NODE_TLS_REJECT_UNAUTHORIZED=0
