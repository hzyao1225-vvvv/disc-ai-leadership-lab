# 依赖与构建产物（镜像内会重新生成）
node_modules
**/node_modules
dist
**/dist
.pnpm-store
.pnpm-cache

# 环境变量（绝不进镜像，部署走 fly secrets）
.env
.env.local
.env.*.local

# 版本控制与 IDE
.git
.gitignore
.vscode
.idea

# 日志与临时
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# 部署脚本本身（避免循环引用）
deploy
Dockerfile*
.dockerignore

# 测试与文档（运行不需要）
**/tests
**/*.test.ts
**/*.spec.ts
coverage
docs
*.md
